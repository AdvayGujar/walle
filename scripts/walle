#!/usr/bin/env bash
# Run the locally built walle CLI.
#
# Interim convenience until 'walle install' exists in M6: it prefers a release
# build and falls back to debug. Never invoke this from skhd long term; point the
# hotkey at the installed binary instead.
set -eo pipefail
cd "$(dirname "$0")/.."
for candidate in .build/scratch/release/walle .build/scratch/debug/walle; do
  if [ -x "$candidate" ]; then exec "$candidate" "$@"; fi
done
echo "walle: no built binary found; run ./scripts/swift.sh build" >&2
exit 1
